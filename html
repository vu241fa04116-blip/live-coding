<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Brew & Bite Cafe</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="styles.css">
</head>

<body>

    <div class="poster">

        <!-- CARD 1 -->
        <div class="card card-one">

            <h2>
                Fresh food.<br>
                Great coffee.<br>
                <span class="highlight">
                    Better moments.
                </span>
            </h2>

            <a href="#" class="order-button">
                ORDER NOW →
            </a>

            <div class="cup">
                ☕
            </div>

        </div>


        <!-- HERO CARD -->
        <div class="card hero">

            <div class="decor-circle"></div>

            <h1>
                Taste the <span>GOOD</span><br>
                <span class="italic">Moments</span> at Our Cafe
            </h1>

            <div class="stars">
                ★ ★ ★ ★ ★
            </div>

            <div class="reviews">
                Freshly prepared • Quality ingredients • Great atmosphere
            </div>

        </div>


        <!-- CARD 3 - MENU -->
        <div class="card card-three">

            <h2>
                Explore<br>
                our menu.
            </h2>

            <div class="menu-board">

                <h3>POPULAR PICKS</h3>

                <div class="menu-row">
                    <span>☕ Cappuccino</span>
                    <strong>₹120</strong>
                </div>

                <div class="menu-row">
                    <span>🥪 Club Sandwich</span>
                    <strong>₹160</strong>
                </div>

                <div class="menu-row">
                    <span>🍕 Cheese Pizza</span>
                    <strong>₹220</strong>
                </div>

                <div class="menu-row">
                    <span>🍰 Chocolate Cake</span>
                    <strong>₹140</strong>
                </div>

                <div class="menu-row">
                    <span>🧋 Cold Coffee</span>
                    <strong>₹150</strong>
                </div>

            </div>

            <p>
                Delicious meals, refreshing drinks
                and freshly baked treats.
            </p>

        </div>


        <!-- CARD 4 -->
        <div class="card card-four">

            <h2>
                Enjoy our<br>
                special<br>
                <strong>COMBO</strong>
            </h2>

            <div class="food-box">

                <span class="food-emoji">
                    🍔 🍟 🥤
                </span>

                <p>
                    Burger + Fries + Cold Drink
                </p>

                <br>

                <strong>
                    ONLY ₹249
                </strong>

            </div>

        </div>


        <!-- CARD 5 -->
        <div class="card card-five">

            <div class="food-icons">
                <span>☕</span>
                <span>🍕</span>
                <span>🍰</span>
            </div>

            <h2>
                Something delicious
                for everyone.
            </h2>

            <p>
                Breakfast • Lunch • Snacks • Desserts
            </p>

        </div>


        <!-- CARD 6 -->
        <div class="card card-six">

            <h2>
                Visit us<br>
                anytime.
            </h2>

            <div class="opening-hours">

                <strong>OPENING HOURS</strong>

                <div class="hours">
                    <span>Mon - Fri</span>
                    <span>9 AM - 10 PM</span>
                </div>

                <div class="hours">
                    <span>Sat - Sun</span>
                    <span>8 AM - 11 PM</span>
                </div>

            </div>

        </div>


        <!-- CARD 7 -->
        <div class="card card-seven">

            <div class="big-number">
                100%
            </div>

            <h3>
                Freshly prepared
            </h3>

            <p>
                Quality ingredients and
                delicious recipes made fresh.
            </p>

            <div class="customer-icons">
                👨‍🍳 👩‍🍳 🧑‍🍳
            </div>

        </div>


        <!-- CARD 8 -->
        <div class="card card-eight">

            <div>

                <h2>
                    Great food.<br>
                    Great place.<br>
                    <span>Great offers.</span>
                </h2>

            </div>

            <div class="discount-box">

                <small>WEEKEND</small>

                <strong>20%</strong>

                <small>OFF</small>

            </div>

            <div class="decor-star">
                ★
            </div>

        </div>

    </div>

</body>
</html>
